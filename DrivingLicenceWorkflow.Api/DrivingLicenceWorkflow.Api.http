#@baseUrl = http://localhost:5237
@baseUrl = http://localhost:8080
@unknownApplicationId = 00000000-0000-0000-0000-000000000001
@photoBase64 = 

### Submit an application for automatic approval (category B, age 36)
# @name submitApprovalCandidate
POST {{baseUrl}}/api/applications
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "dateOfBirth": "1984-01-01",
  "nationalId": "MANUAL-TEST-APPROVAL-001",
  "email": "jane.doe@example.com",
  "phoneNumber": "+30 210 0000000",
  "address": "1 Main Street",
  "licenceCategory": "B",
  "photoBase64": "{{photoBase64}}"
}

### Get current status for the submitted application
GET {{baseUrl}}/api/applications/{{submitApprovalCandidate.response.body.$.applicationId}}
Accept: application/json

### Get audit history for the submitted application
GET {{baseUrl}}/api/applications/{{submitApprovalCandidate.response.body.$.applicationId}}/history
Accept: application/json

### Submit invalid application (expected 400 Bad Request)
POST {{baseUrl}}/api/applications
Content-Type: application/json

{
  "firstName": "",
  "lastName": "Doe",
  "dateOfBirth": "1990-01-01",
  "nationalId": "MANUAL-TEST-INVALID-001",
  "email": "not-an-email",
  "phoneNumber": "+30 210 0000000",
  "address": "1 Main Street",
  "licenceCategory": "B",
  "photoBase64": "{{photoBase64}}"
}

### Get a non-existent application (expected 404 Not Found)
GET {{baseUrl}}/api/applications/{{unknownApplicationId}}
Accept: application/json

### Request approval before manual review (expected 409 Conflict)
POST {{baseUrl}}/api/applications/{{submitApprovalCandidate.response.body.$.applicationId}}/approve

### Request manual review with an invalid reason (expected 400 Bad Request)
POST {{baseUrl}}/api/applications/{{submitApprovalCandidate.response.body.$.applicationId}}/reject
Content-Type: application/json

{
  "reason": " "
}

### Submit an application that requires manual review (category A)
# @name submitManualReviewCandidate
POST {{baseUrl}}/api/applications
Content-Type: application/json

{
  "firstName": "Alex",
  "lastName": "Example",
  "dateOfBirth": "1990-01-01",
  "nationalId": "MANUAL-TEST-REVIEW-001",
  "email": "alex.example@example.com",
  "phoneNumber": "+30 210 0000001",
  "address": "2 Main Street",
  "licenceCategory": "A",
  "photoBase64": "{{photoBase64}}"
}

### Check manual-review application status; wait until it is PendingManualReview
GET {{baseUrl}}/api/applications/{{submitManualReviewCandidate.response.body.$.applicationId}}
Accept: application/json

### Request approval after the status is PendingManualReview
POST {{baseUrl}}/api/applications/{{submitManualReviewCandidate.response.body.$.applicationId}}/approve

### Request rejection instead of approval; run only while PendingManualReview
POST {{baseUrl}}/api/applications/{{submitManualReviewCandidate.response.body.$.applicationId}}/reject
Content-Type: application/json

{
  "reason": "Manual test: supporting documents could not be verified."
}

### Approve an unknown application (expected 404 Not Found)
POST {{baseUrl}}/api/applications/{{unknownApplicationId}}/approve

### Reject an unknown application (expected 404 Not Found)
POST {{baseUrl}}/api/applications/{{unknownApplicationId}}/reject
Content-Type: application/json

{
  "reason": "Manual test."
}
